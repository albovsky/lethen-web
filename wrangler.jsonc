{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lethen",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "previews": {},
  "routes": [
    { "pattern": "lethen.dev", "custom_domain": true },
    { "pattern": "www.lethen.dev", "custom_domain": true }
  ]
}
