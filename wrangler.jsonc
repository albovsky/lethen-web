{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lethen",
  "compatibility_date": "2026-10-02",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "previews": {},
  "routes": [
    { "pattern": "lethen.dev", "custom_domain": true },
    { "pattern": "www.lethen.dev", "custom_domain": true }
  ]
}
